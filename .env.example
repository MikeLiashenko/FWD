# Скопіюйте цей файл як .env і вставте ключ.
# Без ключа додаток працює, але завдання беруться з вбудованого банку.

# Google Gemini — ключ з https://aistudio.google.com/apikey
GEMINI_API_KEY=

# Або Claude — ключ з https://console.anthropic.com (використовується, якщо немає ключа Gemini)
# ANTHROPIC_API_KEY=

# Хмарна копія бази у Firebase Realtime Database (розділ /zdt).
# Також потрібен файл firebase-key.json (Project settings → Service accounts → Generate new private key).
# FIREBASE_DATABASE_URL=https://ваш-проєкт-default-rtdb.europe-west1.firebasedatabase.app

# Доступ звідусіль через Cloudflare Tunnel; адреса публікується у Firebase для сторінки на GitHub Pages
# ZDT_TUNNEL=on
# ZDT_PUBLIC_URL=https://ваш-логін.github.io/ваш-репозиторій/

# Необов'язково
# PORT=3000
# ZDT_GEMINI_MODEL=gemini-flash-latest   # список моделей: node --env-file=.env scripts/gemini-models.mjs
# ZDT_MODEL=claude-opus-5-5
